<Project>
  <!-- ??? Sdk ????? meeko-platform ?????? Directory.Build.props -->
  <PropertyGroup>
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
  </PropertyGroup>

  <Sdk Name="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <Description>Meeko cross-service contracts: MagicOnion service interfaces + MessagePack DTOs not owned by Product.Common. Product-facing RPC contracts live in common/Product.Common/Contracts and are referenced via Product.Common.</Description>
    <IsPackable>false</IsPackable>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Common\Platform.Common\Platform.Common.csproj" />
    <ProjectReference Include="..\..\Common\Product.Common\Product.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MagicOnion.Abstractions" />
    <PackageReference Include="MessagePack" />
  </ItemGroup>

</Project>

